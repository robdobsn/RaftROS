# Unexpected Maker FeatherS3 (ESP32-S3, 16 MB flash, 8 MB PSRAM).  The image
# uses the same 4 MB layout as SysTypeMain.

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Console on the USB port, as on SysTypeMain.  When the Zenoh serial link is
# chosen (RaftROS "link":"usbjtag" or /api/ros/set?link=usbjtag) RaftROS takes
# the port over - SerialConsole lets go and RaftCore's RaftConsolePort
# silences every other console writer - and gives it back when the link is
# set to tcp again (typing ros/set?link=tcp in a terminal on the port works
# while the router is stopped).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="build/raft/partitions.csv"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=10000
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MDNS_PREDEF_NETIF_STA=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# 8 MB quad SPI PSRAM - keeps large buffers (e.g. web server) out of internal RAM which WiFi and lwIP need
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
