                    ],
                    "c": {
                        "n": "apds9960_raw",
                        "c": "out.als=buf[0]|(buf[1]<<8);out.red=buf[2]|(buf[3]<<8);out.green=buf[4]|(buf[5]<<8);out.blue=buf[6]|(buf[7]<<8);out.prox=buf[8];"
                    },
                    "us": 100000
                }
            }
        },
        "MPU6050": {
            "_notes": "InvenSense 6-axis IMU. WHO_AM_I (0x75) reads 0x68 on a genuine MPU-6050; 0x70 (MPU-6500), 0x72 and 0x98 are common on clone modules with the same register map for these reads. Init: wake on the X gyro PLL, DLPF 44 Hz, 100 Hz sample rate, gyro +-500 deg/s (65.5 LSB per deg/s), accel +-4 g (8192 LSB/g). Poll reads ACCEL_XOUT_H..GYRO_ZOUT_L (0x3B-0x48), big-endian. Standard decode: the generated code applies each attribute's d/a while decoding, so the struct holds g, deg/s and deg C.",
            "addresses": "0x68,0x69",
            "deviceType": "MPU6050",
            "detectionValues": "0x75=0x68,0x70,0x72,0x98",
            "initValues": "0x6b01&0x1a03&0x1909&0x1b08&0x1c08",
            "pollInfo": {
                "c": "0x3b=r14",
                "i": 50,
                "s": 1
            },
            "scanPriority": "high",
            "devInfoJson": {
