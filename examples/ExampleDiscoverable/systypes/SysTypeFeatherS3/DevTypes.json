{
    "devTypes": {
        "APDS9960": {
            "_notes": "Avago/Broadcom proximity, ambient light, RGB and gesture sensor. ID register 0x92 reads 0xAB (0xA8 and 0x9C on some modules). Init: ATIME 0xDB (~103 ms, full scale 37888 counts), AGAIN 4x and PGAIN 2x, 8 x 16 us proximity pulses, then PON|AEN|PEN. Poll reads CDATAL..PDATA (0x94-0x9C) in one transaction; gesture engine left off. Custom decode (an example of one): it stores raw counts and the table's d/a (prox /255) are applied by whoever reads the field, as for any custom decode. The generator ends a custom decode with next; when it has none.",
            "addresses": "0x39",
            "deviceType": "APDS9960",
            "detectionValues": "0x92=0xab,0xa8,0x9c",
            "initValues": "0x81db&0x8f05&0x8e87&0x8007",
            "pollInfo": {
                "c": "0x94=r9",
                "i": 100,
                "s": 1
            },
            "scanPriority": "high",
            "devInfoJson": {
                "name": "Proximity, Light, RGB & Gesture",
                "desc": "Ambient light (clear channel), RGB and proximity",
                "manu": "Broadcom",
                "type": "APDS9960",
                "clas": [
                    "PROX",
                    "LGHT"
                ],
                "resp": {
                    "b": 9,
                    "a": [
                        {
                            "n": "als",
                            "t": "<H",
                            "u": "counts",
                            "r": [
                                0,
                                65535
                            ],
                            "f": "5d",
                            "o": "float"
                        },
                        {
                            "n": "red",
                            "t": "<H",
                            "u": "counts",
                            "r": [
                                0,
                                65535
                            ],
                            "f": "5d",
                            "o": "uint16"
                        },
                        {
                            "n": "green",
                            "t": "<H",
                            "u": "counts",
                            "r": [
                                0,
                                65535
                            ],
                            "f": "5d",
                            "o": "uint16"
                        },
                        {
                            "n": "blue",
                            "t": "<H",
                            "u": "counts",
                            "r": [
                                0,
                                65535
                            ],
                            "f": "5d",
                            "o": "uint16"
                        },
                        {
                            "n": "prox",
